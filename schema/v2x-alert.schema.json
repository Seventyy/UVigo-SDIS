{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V2X alert",
  "description": "Alert raised by V2X-SERVICE (origin: cloud) or by an RSU (origin: rsu). Travels over SNS (cloud) and MQTT (to vehicles).",
  "type": "object",
  "required": ["alert_id", "alert_type", "origin", "severity", "created_time",
               "location", "cause_event_ids", "message", "schema_version"],
  "properties": {
    "alert_id": {"type": "string", "description": "Deterministic: built from the cause event id, so a duplicate is detectable"},
    "alert_type": {"enum": ["sudden_braking", "local_hard_braking", "local_crash"]},
    "origin": {"enum": ["rsu", "cloud"]},
    "severity": {"type": "integer", "minimum": 1, "maximum": 3},
    "created_time": {"type": "string", "description": "ISO 8601 UTC with milliseconds, e.g. 2026-11-14T10:15:30.123Z"},
    "location": {
      "type": "object", "required": ["segment_id", "rsu_id"],
      "properties": {
        "segment_id": {"type": "string", "pattern": "^S[0-9]{2}$"},
        "rsu_id": {"enum": ["rsu-1", "rsu-2"]}
      }
    },
    "cause_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "message": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "trace": {"type": "object"}
  },
  "additionalProperties": false
}
